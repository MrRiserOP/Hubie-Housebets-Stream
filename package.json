{
  "name": "hubie-streamer",
  "version": "2.0.0",
  "private": true,
  "description": "Hubie \u2014 autonomous AI streamer (sloth in a top hat): local Limbo game, Kick chat + stream, OBS",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build:engine && vite build --config apps/avatar/vite.config.ts",
    "dev:avatar": "vite --config apps/avatar/vite.config.ts",
    "controller": "node --no-warnings --import tsx apps/controller/src/main.ts",
    "game-agent": "node --no-warnings --import tsx apps/game-agent/src/main.ts",
    "chat-agent": "node --no-warnings --import tsx apps/chat-agent/src/main.ts",
    "stream-engine": "node --no-warnings --import tsx apps/stream-engine/src/main.ts",
    "start": "npm run build && node --no-warnings --import tsx scripts/dev-all.ts",
    "estop": "node --no-warnings --import tsx scripts/estop.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node --no-warnings --import tsx tests/e2e/run-e2e.ts",
    "test:failures": "node --no-warnings --import tsx tests/e2e/run-failures.ts",
    "test:entertainment": "node --no-warnings --import tsx tests/e2e/run-entertainment.ts",
    "test:soak": "node --no-warnings --import tsx tests/e2e/soak.ts",
    "render:rig": "node --no-warnings --import tsx scripts/render-rig.tsx",
    "render:diagram": "node --no-warnings --import tsx scripts/render-diagram.ts",
    "start:pm2": "npm run build && pm2 start config/ecosystem.config.cjs && pm2 save",
    "stop:pm2": "pm2 delete config/ecosystem.config.cjs",
    "test:live-anthropic": "node --no-warnings --import tsx tests/live/anthropic-live.ts",
    "test:live-openai": "node --no-warnings --import tsx tests/live/openai-live.ts",
    "test:control-center": "node --no-warnings --import tsx tests/e2e/run-control-center.ts",
    "test:kick": "node --no-warnings --import tsx tests/e2e/run-kick.ts",
    "test:fps": "node --no-warnings --import tsx tests/e2e/run-fps.ts",
    "test:kick-wizard": "node --no-warnings --import tsx tests/e2e/run-kick-wizard.ts",
    "test:cloud": "node --no-warnings --import tsx tests/e2e/run-cloud.ts",
    "test:audio": "node --no-warnings --import tsx tests/e2e/run-audio.ts",
    "build:engine": "esbuild packages/game-adapters/src/limboBrowser.ts --bundle --format=iife --global-name=LimboSim --target=es2020 --outfile=assets/limbo-sim/engine.js --log-level=warning"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "dotenv": "^18.0.10",
    "obs-websocket-js": "^5.0.8",
    "openai": "^7.57.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "mermaid": "^12.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
