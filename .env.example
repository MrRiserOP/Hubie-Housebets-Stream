# ─────────────────────────────────────────────────────────────
# Hubie configuration.
# You normally DON'T edit this by hand: open http://127.0.0.1:8787/setup
# and the setup wizard writes your settings into .env for you.
# Hubie runs in DEMO MODE (built-in lines + browser-voice fallback) until an Anthropic key (brain) and an ElevenLabs key (voice) are saved.
# NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Setup state (managed by the wizard) ──────────────────────
SETUP_DONE=false
# Start the show automatically when the app starts (useful on a VPS once set up)
AUTO_START=false

# ── Web server ───────────────────────────────────────────────
CONTROLLER_PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Access token for using /setup and /control from another computer (VPS installer generates one).
CONTROL_TOKEN=

# ── Brain: Anthropic Claude (recommended) ────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── Voice: ElevenLabs (the only voice provider) ──────────────
# Create a key at elevenlabs.io → Developers → API Keys (enable Text to Speech + Voices: read). Paste it in Control Center → 2.
ELEVENLABS_API_KEY=
# Default voice: "Charlie" (energetic, warm, playful). Pick another in Control Center → 2 (▶ previews your account's voices).
ELEVENLABS_VOICE_ID=IKne3meq5aSn9XLyUdCD
# eleven_turbo_v2_5 (default, fast) | eleven_flash_v2_5 (fastest) | eleven_multilingual_v2 (richest)
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Base delivery; the emotion of each line adjusts these (all 0–1, speed 0.7–1.2)
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEED=1
ELEVENLABS_SPEAKER_BOOST=true
# Spending guard: characters of speech per rolling hour
ELEVENLABS_MAX_CHARS_PER_HOUR=100000
# elevenlabs (default when a key is saved) | browser (the page's built-in voice — always labelled as a fallback)
TTS_PROVIDER=
# If every ElevenLabs key fails: browser (free, labelled as fallback) | espeak | none (stay silent).
# Extra backup ElevenLabs keys are added in the Control Center (section 13) and stored in data/elevenlabs-keys.json — not here.
TTS_FALLBACKS=browser
TTS_TIMEOUT_MS=20000

# ── OpenAI (OPTIONAL text-only backup brain; never used for voice) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_LLM_CALLS_PER_HOUR=900
OPENAI_BASE_URL=
# Provider selection (empty = automatic: Anthropic when a key is saved, then OpenAI, else demo)
LLM_PROVIDER=
LLM_TIMEOUT_MS=12000

# ── Game agent ───────────────────────────────────────────────
# limbo-sim  = Hubie's own local Limbo game (default; no real site, no real money)
# local-demo = developer test page
# Game settings (targets, win weights, delay) live in config/limbo-sim.json / the Control Center.
GAME_ADAPTER=limbo-sim
# Only needed if Chrome/Edge can't be found automatically
BROWSER_EXECUTABLE_PATH=
GAME_HEADLESS=true
GAME_FRAME_FPS=8
GAME_FALLBACK_TO_SIM=true

# ── Kick (set these in the Control Center → 4 and 5; no need to edit here) ──
KICK_ENABLED=false
# your channel name as in kick.com/<name>
KICK_CHANNEL=
# from kick.com/settings/developer → your app
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# must match the Redirect URL in your Kick app (default shown in the Control Center)
KICK_REDIRECT_URI=
# public HTTPS address Kick sends chat events to (ends with /kick/webhook)
KICK_WEBHOOK_URL=
# cloudflared = Hubie starts (and installs, if missing) Cloudflare's free quick tunnel and shows you the ONE address to paste
# into your Kick app. Set by the "Connect Kick Chat" wizard. Leave empty when you use a fixed KICK_WEBHOOK_URL (server install).
KICK_TUNNEL=
KICK_WEBHOOK_PORT=8788
KICK_AUTO_MODERATE=true
KICK_MIN_SEND_INTERVAL_SEC=3

# ── OBS (1080p60 for Kick: 1920×1080, 60 fps, x264 CBR 6000 kbps, keyframe 2 s — applied by Control Center → 6) ──
OBS_ENABLED=false
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
OBS_SCENE=Hubie Live
OBS_AUTOSTART_STREAM=false
OBS_STREAM_SERVER=
OBS_STREAM_KEY=
# VPS only: run a headless OBS under PM2
OBS_MANAGED=false

# ── Show ─────────────────────────────────────────────────────
SHOW_TITLE=Hubie's House Party

# --- Streamable cloud mode (see docs/STREAMABLE-CLOUD.md) ---
# streamable-cloud = no OBS on this machine; Streamable's cloud OBS loads the overlay as a Browser Source and encodes/sends to Kick.
STREAM_MODE=
# public host that serves ONLY the read-only overlay (set by the VPS installer)
PUBLIC_HOST=
# view-only token for the public overlay link (generated automatically)
OVERLAY_TOKEN=
